{
  "extends": "../../tooling/typescript/base.json",
  "compilerOptions": {
    // Throwaway experiment code: it is executed with `tsx` and never built, so
    // there is no `dist`, no project reference and nothing for another workspace
    // to import.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts", "vitest.config.ts", "../../tooling/vitest/*.ts"]
}
