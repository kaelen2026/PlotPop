# Copy to `.env` for local development. The values below match the services in
# `docker/compose.yaml`, so `docker compose up` and `pnpm dev` agree out of the box.
#
# `packages/config` parses this file in its own test suite: a variable added to a
# service schema has to appear here, with a value the schema accepts.

# development | test | production
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug

# --- apps/api -----------------------------------------------------------------
API_PORT=3001

# Better Auth is held by the api alone (ADR-007). The worker acts under an
# internal service identity and never signs or reads a user session.
#
# Signs sessions; at least 32 characters. Production takes it from a secret
# manager, never from a file in the repository.
BETTER_AUTH_SECRET=local-development-session-signing-secret
# The origin the browser talks to. Web proxies `/api/*` to the api on a single
# origin, so this is the web origin and not the api port.
AUTH_BASE_URL=http://localhost:3000
# Explicit allowlist, comma separated. Production configuration must not contain
# a loopback origin; the api refuses to start if it does.
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# --- apps/worker --------------------------------------------------------------
# Liveness and readiness only; the worker exposes no public API.
WORKER_PORT=3002

# --- apps/web -----------------------------------------------------------------
# Where the web tier reaches the api. Production serves both from one origin
# (ADR-007), so this points at the api container only in local development.
API_BASE_URL=http://localhost:3001

# --- Backing services (api and worker only, never the web tier) ---------------
DATABASE_URL=postgresql://plotpop:plotpop@localhost:5432/plotpop
REDIS_URL=redis://localhost:6379

# S3-compatible storage. Local development uses the MinIO service from compose.
STORAGE_ENDPOINT=http://localhost:9000
# The origin the browser is sent to for a signed upload (api only). SigV4 signs the
# host, so this has to be the address the browser can reach: identical to the line
# above when the api runs on the host, but `http://minio:9000` above and this line
# unchanged when the api runs inside compose.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=plotpop-local
STORAGE_ACCESS_KEY_ID=plotpop
STORAGE_SECRET_ACCESS_KEY=plotpop-local-secret
