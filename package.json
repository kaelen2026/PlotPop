{
  "name": "plotpop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "tsc --project e2e/tsconfig.json && playwright test",
    "docker:up": "docker compose --file docker/compose.yaml up --build --detach --wait",
    "docker:down": "docker compose --file docker/compose.yaml down",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "1.62.0",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
